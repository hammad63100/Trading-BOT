# =============================================================================
# XAU/USD Gold Trading Bot — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Broker Credentials (MetaTrader 5) ---
BROKER_LOGIN=12345678
BROKER_PASSWORD=your_mt5_password_here
BROKER_SERVER=YourBroker-Demo

# --- Alert Webhook ---
# Telegram Bot: https://api.telegram.org/bot<TOKEN>/sendMessage
# Slack Webhook: https://hooks.slack.com/services/XXX/YYY/ZZZ
ALERT_WEBHOOK_URL=https://api.telegram.org/bot000000000:XXXXXXXXXX/sendMessage
ALERT_CHAT_ID=your_telegram_chat_id

# --- Trading Parameters (override defaults) ---
# SYMBOL=XAUUSD
# TIMEFRAME=M15
# POLL_INTERVAL_SECONDS=30
# MAX_RISK_PER_TRADE=0.005
# MAX_DAILY_LOSS_PCT=0.02
# MAX_OPEN_POSITIONS=2
# MAX_TRADES_PER_DAY=5
# COOLDOWN_AFTER_LOSS_MIN=30
# ATR_SL_MULTIPLIER=1.5
# ATR_TP_MULTIPLIER=3.0
# MIN_SIGNAL_CONFIDENCE=0.6

# --- Mode ---
# Set to 'demo' for paper trading, 'live' for real trading
TRADING_MODE=demo
